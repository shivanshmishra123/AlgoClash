# ─── AlgoClash Backend Environment Variables ───

# Server
PORT=8080

# Database (Neon PostgreSQL — use the connection string from Neon dashboard)
# Format: jdbc:postgresql://<host>/<database>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxx.us-east-2.aws.neon.tech/algoclash?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password

# JWT Authentication
JWT_SECRET=change_me_to_a_64_char_hex_string
JWT_EXPIRATION_HOURS=24

# CORS (set to your Vercel frontend URL in production)
APP_CORS_ALLOWED_ORIGIN=https://algoclash.vercel.app

# Code Execution Engine (Judge0-compatible)
# Option A: OnlineCompiler.io (Free tier: 100k runs/mo - https://onlinecompiler.io)
JUDGE0_URL=https://api.onlinecompiler.io/api/judge0
JUDGE0_API_KEY=your_onlinecompiler_api_key

# Option B: Self-hosted Judge0 (e.g., Oracle Cloud Always Free VM or local Docker)
# JUDGE0_URL=http://localhost:2358
# JUDGE0_API_KEY=
